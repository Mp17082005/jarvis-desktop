# Copy to .env. Never commit real keys or ACCESS.txt.
JARVIS_ACCESS_TOKEN=replace-with-a-long-random-password
JARVIS_LLM_BASE_URL=https://your-openai-compatible-provider.example/v1
JARVIS_LLM_MODEL=your-model
JARVIS_LLM_API_KEY=your-key
JARVIS_DATA_DIR=data
JARVIS_WORKSPACE_DIR=workspace
# Search service (start existing SearXNG separately)
JARVIS_SEARCH_URL=http://127.0.0.1:8888
# Optional Gmail IMAP / SMTP credentials
JARVIS_GMAIL_ADDRESS=
JARVIS_GMAIL_APP_PASSWORD=
# Optional Telegram, fixed destination only
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_CHAT_ID=
# Optional Google Workspace wrapper for Calendar / Gmail OAuth
JARVIS_GOOGLE_SCRIPT=
JARVIS_GOOGLE_PYTHON=
# Native realtime: enable only for a controlled private canary.
JARVIS_REALTIME_ENABLED=false
# Allows reconnects without the original overly restrictive six-start lockout.
JARVIS_REALTIME_STARTS_PER_HOUR=30
JARVIS_REALTIME_SESSION_SECONDS=3300
# Desktop controls only on an installed loopback instance, never public ingress.
JARVIS_DESKTOP_ENABLED=false
JARVIS_DESKTOP_LOCAL_ONLY=true
# Optional downloaded offline wake model; requires an actual microphone.
JARVIS_WAKE_MODEL_PATH=
JARVIS_REALTIME_MODEL=gpt-realtime-2.1
# Base/key default to LLM provider. Gateway must support client_secrets + calls.
# JARVIS_REALTIME_BASE_URL=https://your-realtime-gateway.example/v1
# JARVIS_REALTIME_API_KEY=
# Optional explicit neural-TTS module, not the native transport.
JARVIS_TTS_MODEL=tts-mai-voice-2
JARVIS_TTS_VOICE=alloy

