+def _stdin_is_interactive() -> bool:
+    """Return True only when stdin is an attached, usable terminal."""
+    try:
+        if sys.stdin is None or not sys.stdin.isatty():
+            return False
+        if os.name == "nt":
+            # isatty() is True for NUL on Windows; require a real console handle.
+            import ctypes
+            from ctypes import wintypes
+
+            k32 = ctypes.windll.kernel32
+            k32.GetStdHandle.restype = wintypes.HANDLE
+            mode = wintypes.DWORD()
+            return bool(k32.GetConsoleMode(k32.GetStdHandle(-10), ctypes.byref(mode)))
+        return True
+    except (ValueError, OSError, AttributeError):
+        return False
+
